---
layout: layouts/base.njk
title: Vremeplov
lang: hr
useTimelineStyles: true
---
{% set timeline = timeline or (nav and nav.timeline) %}
<main class="page page-vremeplov" id="top">
  <header class="hero hero-vremeplov">
    <div class="container-large-2">
      <h1 class="hero__title">{{ timeline.ui.pageTitle }}</h1>
    </div>
  </header>

  <div class="timelineSticky">
    <section class="topline" aria-label="{{ timeline.ui.toplineAria }}">
      <div class="container-large-2">
        <div class="topline__scroller">
          {% set totalDuration = 0 %}
          {% for segment in timeline.config.segments %}
          {% set totalDuration = totalDuration + (segment.toYear - segment.fromYear) %}
          {% endfor %}
          {% set timelineStart = timeline.config.segments[0].fromYear %}
          {% set timelineEnd = timeline.config.presentYear %}
          {% set zeroPosition = ((0 - timelineStart) / (timelineEnd - timelineStart)) * 100 %}
          <div class="topline__durationWrap" aria-hidden="true">
            <div class="topline__durationScale">
              <span class="durationScale__label is-start" style="left: 0%;">{{ timeline.ui.scaleStartLabel }}</span>
              <span class="durationScale__label is-mid" style="left: {{ zeroPosition }}%;">0</span>
              <span class="durationScale__label is-end-right" style="left: 100%;">{{ timeline.ui.scaleEndLabel }}</span>
            </div>
            <div class="topline__durationBar">
              {% for segment in timeline.config.segments %}
              {% set duration = segment.toYear - segment.fromYear %}
              <span class="durationBar__seg seg--{{ segment.key }}" style="--seg-ratio: {{ duration }};"></span>
              {% endfor %}
            </div>
          </div>
          <div class="topline__bus" aria-hidden="true">
            <svg class="topline__busSvg"></svg>
          </div>

          <div class="topline__segments">
            <div class="topline__track" role="navigation" aria-label="{{ timeline.ui.trackAria }}">
            {% for segment in timeline.config.segments %}
            <div class="topline__segment seg seg--{{ segment.key }}" data-seg="{{ segment.key }}" style="--seg-ratio: {{ segment.widthRatio }};">
              {% if segment.key != 'algorithmic' %}
              <div class="seg__head">
                <span class="seg__title">
                  <span class="seg__title-main">{{ segment.labelMain or segment.label }}</span>
                  {% if segment.labelSub %}<span class="seg__title-sub">{{ segment.labelSub }}</span>{% endif %}
                </span>
                <span class="seg__range">{{ (segment.rangeLabelHtml or segment.rangeLabel) | safe }}</span>
              </div>
              {% else %}
              <div class="seg__head seg__head--ghost" aria-hidden="true"></div>
              {% endif %}

              <div class="seg__line">
                {% for event in timeline.events %}
                {% if event.segment == segment.key %}
                {% if segment.key == 'algorithmic' %}
                {% set left = 50 %}
                {% else %}
                {% set rawLeft = ((event.yearSort - segment.fromYear) / (segment.toYear - segment.fromYear)) * 100 %}
                {% set left = rawLeft %}
                {% if left < 4 %}{% set left = 4 %}{% endif %}
                {% if left > 96 %}{% set left = 96 %}{% endif %}
                {% if event.yearSort == segment.fromYear %}{% set left = 0 %}{% endif %}
                {% if event.yearSort == segment.toYear and segment.key != 'premechanical' %}{% set left = 100 %}{% endif %}
                {% endif %}
                {% set markerLabel = event.toplineLabelHtml or event.yearLabel %}
                {% set isMechanicalStart = segment.key == 'mechanical' and event.yearSort == segment.fromYear %}
                {% set isStandaloneYear = segment.key == 'algorithmic' %}
                {% set isSegmentStart = segment.key != 'algorithmic' and event.yearSort == segment.fromYear %}
                <button class="mk{% if event.isFeatured %} mk--featured{% else %} mk--global{% endif %}{% if isMechanicalStart %} mk--vertical-label{% endif %}{% if isStandaloneYear %} mk--standalone-year{% endif %}{% if isSegmentStart %} mk--segment-start{% endif %}" type="button" data-target="{{ event.id }}" aria-label="{{ event.yearLabel }} - {{ event.title }}" style="left: {{ left }}%;">
                  <span class="mk__dot" aria-hidden="true"></span>
                  <span class="mk__label">{{ markerLabel | safe }}</span>
                </button>
                {% endif %}
                {% endfor %}
              </div>
            </div>
            {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="vtimeline" aria-label="{{ timeline.ui.vtimelineAria }}">
    <div class="vtimeline__snap">
      {% for event in timeline.events %}
      {% set nextEvent = timeline.events[loop.index0 + 1] %}
      {% if nextEvent %}
      {% set delta = nextEvent.yearSort - event.yearSort %}
      {% else %}
      {% set delta = 24 %}
      {% endif %}
      {% set gapClass = "sm" %}
      {% if delta > 4000 %}{% set gapClass = "xxl" %}{% elseif delta > 1000 %}{% set gapClass = "xl" %}{% elseif delta > 200 %}{% set gapClass = "lg" %}{% elseif delta > 50 %}{% set gapClass = "md" %}{% endif %}
      {% set axisYear = event.axisLabelHtml or event.yearLabel %}
      <article class="vtimeline-step{% if event.isFeatured %} is-featured{% endif %}" id="{{ event.id }}" data-id="{{ event.id }}" data-seg="{{ event.segment }}" data-gap="{{ gapClass }}">
        <div class="vtimeline-step__inner container-large-2">
          <div class="vtimeline-step__center">
            <div class="vtimeline-step__line" aria-hidden="true"></div>
            <div class="vtimeline-step__cross" aria-hidden="true"></div>
            <div class="vtimeline-step__axisTick" aria-hidden="true"></div>
            <div class="vtimeline-step__axisYear" aria-hidden="true">{{ axisYear | safe }}</div>

            <div class="vtimeline-step__icon" aria-label="{{ event.title }}">
              {% if event.image_placeholder or not event.image %}
              <span class="vtimeline-step__placeholder" aria-hidden="true"></span>
              {% else %}
              <img src="{{ event.image }}" alt="{{ event.title }}" class="vtimeline-step__image" loading="lazy" />
              {% endif %}
            </div>
            {% if event.isFeatured and event.featuredLabel %}
            <div class="vtimeline-step__badge">{{ event.featuredLabel }}</div>
            {% endif %}
          </div>

          <aside class="vtimeline-step__info" data-info hidden>
            <div class="infoBox">
              <div class="infoBox__bgLayer" aria-hidden="true"></div>
              <div class="infoBox__content">
                <div class="infoBox__head">
                  <span class="infoBox__meta">{{ event.era }}</span>
                </div>
                {% set titleMain = event.title %}
                {% if event.subtitle %}{% set titleMain = event.title | replace(" – " ~ event.subtitle, "") | replace(" â€“ " ~ event.subtitle, "") | replace(" - " ~ event.subtitle, "") %}{% endif %}
                <h2 class="infoBox__title"><span class="infoBox__title-main">{{ titleMain }}</span>{% if event.subtitle %}<span class="infoBox__subtitle">{{ event.subtitle }}</span>{% endif %}</h2>
                <p class="infoBox__body">{{ event.detail }}</p>
                {% if event.isFeatured and event.ctaHref and event.ctaLabel %}
                <p class="infoBox__ctaRow"><a class="infoBox__cta" href="{{ event.ctaHref }}">{{ event.ctaLabel }}</a></p>
                {% endif %}
              </div>
            </div>
          </aside>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>

</main>
