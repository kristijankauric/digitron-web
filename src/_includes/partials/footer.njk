{% set currentLang = lang | default("hr") %}
{% set t = i18n[currentLang] | default(i18n.hr) %}
<section class="footer">
  <div class="footer-circuit-layer" aria-hidden="true"></div>
  <footer class="footer3_component">
    <div class="padding-global">
      <div class="container-large-4">
        <div class="padding-vertical padding-xxlarge">
          <div class="padding-bottom padding-xxlarge">
            <div class="w-layout-grid footer3_top-wrapper">
              <div class="footer3_left-wrapper">
                <div class="margin-bottom margin-medium footer-project__logo">
                  <a href="{{ t.home_href | default('/hr/') }}" class="footer3_logo-link w-nav-brand"><img src="/assets/images/final/extra/Digitron.Buje%20logo%206.png" loading="lazy" alt="{{ t.logo_alt | default('digitron.buje logo') }}" class="logo-footer"/></a>
                </div>
                <div class="margin-bottom margin-small footer-media footer-project__media">
                  <video
                    class="footer-media__video"
                    data-footer-loop-video
                    muted
                    playsinline
                    loop
                    preload="metadata"
                    poster="/assets/images/final/extra/video%20slikice/footer%20buje%20slika.jpg"
                    aria-label="Digitron Buje video"
                  >
                    <source src="/assets/images/final/extra/video%20slikice/footer%20buje.mp4" type="video/mp4" />
                  </video>
                </div>
                <div class="margin-bottom margin-small footer-project__content">
                  <div class="footer3_details-wrapper footer-project__details">
                    <div class="margin-bottom margin-xxsmall"><div class="naslov-radno-vrijeme footer-line--tagline">{{ t.footer_tagline | default("Digitalna interpretacija industrijske baštine Buja") }}</div></div>
                    <div class="margin-bottom margin-xxsmall"><div class="text-dodatni-info footer-line--description">{{ t.footer_description | default("Ova digitalna izložba istražuje razvoj strojeva za računanje – od najranijih alata do elektroničkih kalkulatora – i priču o tvornici Digitron, koja je iz Buja postala dio svjetske tehnološke revolucije.") }}</div></div>
                    <div class="margin-bottom margin-xxsmall"><div class="text-dodatni-info footer-line--project">{{ t.footer_project_label | default("Projekt Grada Buje – Buie") }}</div></div>
                    <div class="margin-bottom margin-xxsmall"><div class="text-tel-radno footer-line--copyright">{{ t.footer_copyright | default("© Grad Buje – Buie, 2026") }}</div></div>
                  </div>
                </div>
              </div>

              <div id="w-node-footer-nav" class="footer-nav">
                <div class="footer-nav__primary">
                  {% set primary = nav.sections[0] %}
                  <div class="footer1_link-list footer-nav__column footer-nav__column--primary">
                    <div class="margin-bottom margin-xsmall"><div class="text-weight-semibold-2">{{ primary.title }}</div></div>
                    {% if primary.href %}
                    <a href="{{ primary.href }}" class="footer1_link{% if page.url == primary.href %} w--current{% endif %}">{{ primary.title }}</a>
                    {% endif %}
                  </div>
                </div>

                <div class="footer-nav__secondary">
                  {% for section in nav.sections %}
                  {% if loop.index0 > 0 %}
                  <div class="footer1_link-list footer-nav__column">
                    <div class="margin-bottom margin-xsmall"><div class="text-weight-semibold-2">{{ section.title }}</div></div>
                    {% for item in section.items %}
                    <a href="{{ item.href }}" class="footer1_link{% if page.url == item.href %} w--current{% endif %}">{{ item.label }}</a>
                    {% endfor %}
                  </div>
                  {% endif %}
                  {% endfor %}
                </div>

                <div class="footer-nav__impressum">
                  <a href="{{ t.impressum_href | default('/impressum') }}" class="footer1_link link-impressum">{{ t.impressum_label | default("Impressum") }}</a>
                </div>
              </div>
            </div>
          </div>
          <div class="line-divider"></div>
        </div>
      </div>
    </div>
  </footer>
</section>

<div class="html-embed w-embed">
  <audio id="track" preload="metadata">
    <source src="{{ audioSrc | default('/assets/audio/hr/04-i-bi-digitron.mp3') }}" type="audio/mpeg" />
  </audio>
</div>

