<!doctype html>
<html lang="{{ lang | default('hr') }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title | default('Retrobit') }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
  <link href="/assets/css/webflow-style.css" rel="stylesheet" type="text/css" />
  {% if useTimelineStyles %}<link href="/assets/css/vremeplov.css?v=20260306b" rel="stylesheet" type="text/css" />{% endif %}
  <style>
    html,
    body,
    .body {
      font-family: "Open Sans", sans-serif !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .page-wrapper,
    .main-wrapper {
      margin: 0 !important;
      padding-top: 0 !important;
    }

    body div,
    body p,
    body span,
    body a,
    body li,
    body h1,
    body h2,
    body h3,
    body h4,
    body h5,
    body h6,
    body button,
    body input,
    body textarea,
    body select,
    body label,
    body strong,
    body em,
    body small,
    body td,
    body th,
    body *::before,
    body *::after {
      font-family: "Open Sans", sans-serif !important;
    }

    .navbar07_menu-left > .navbar07_link,
    .navbar07_menu-left > .navbar07_menu-dropdown > .navbar07_dropdown-toggle .text-size-regular {
      font-weight: 700 !important;
    }

    .navbar07_menu-left > .navbar07_link.w--current {
      color: #a9afa6 !important;
      opacity: 1 !important;
    }

    .navbar07_dropdown-link-2,
    .navbar07_dropdown-link-2 .text-weight-bold,
    .navbar07_dropdown-link-2 .text-weight-normal-2 {
      font-weight: 400 !important;
    }

    .navbar07_menu-dropdown {
      position: relative;
    }

    .navbar07_component {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      top: 0 !important;
      position: sticky !important;
      transform: none !important;
      z-index: 4000 !important;
      background: #fff !important;
      padding-top: 0 !important;
      padding-bottom: 0.25rem !important;
      min-height: 5rem !important;
      overflow: visible !important;
      isolation: isolate;
    }

    .navbar07_component::before {
      content: none;
    }

    .navbar07_component::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -18px;
      height: 20px;
      background: #fff;
      clip-path: polygon(0 0, 3% 16%, 6% 2%, 9% 18%, 12% 4%, 15% 20%, 18% 6%, 21% 18%, 24% 4%, 27% 20%, 30% 6%, 33% 18%, 36% 3%, 39% 19%, 42% 5%, 45% 20%, 48% 4%, 51% 18%, 54% 3%, 57% 19%, 60% 5%, 63% 20%, 66% 4%, 69% 18%, 72% 3%, 75% 19%, 78% 5%, 81% 20%, 84% 4%, 87% 18%, 90% 3%, 93% 19%, 96% 5%, 100% 16%, 100% 100%, 0 100%);
      pointer-events: none;
      z-index: 1;
    }

    .navbar07_container,
    .navbar07_menu {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }

    .section_heroheader05 .heroheader05_component {
      align-items: flex-start !important;
    }

    .navbar07_dropdown-list {
      z-index: 1000;
    }

    .logo-footer {
      width: 220px;
      max-width: 100%;
      height: auto;
    }

    .footer {
      position: relative;
      overflow: visible;
    }

    .footer::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: -38px;
      height: 44px;
      background:
        repeating-linear-gradient(to bottom, rgba(31, 63, 68, 0.18) 0 1px, rgba(246, 242, 231, 0) 1px 10px),
        linear-gradient(180deg, #f6f2e7 0%, #efe9d8 100%);
      clip-path: polygon(0 0, 100% 0, 100% 58%, 97% 72%, 94% 60%, 91% 76%, 88% 62%, 85% 78%, 82% 64%, 79% 79%, 76% 62%, 73% 77%, 70% 61%, 67% 78%, 64% 60%, 61% 74%, 58% 59%, 55% 76%, 52% 61%, 49% 78%, 46% 62%, 43% 77%, 40% 58%, 37% 76%, 34% 61%, 31% 75%, 28% 60%, 25% 74%, 22% 58%, 19% 72%, 16% 59%, 13% 71%, 10% 58%, 7% 70%, 4% 57%, 0 66%);
      pointer-events: none;
      z-index: 2;
    }

    .footer::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -34px;
      height: 40px;
      background:
        repeating-linear-gradient(to bottom, rgba(18, 54, 58, 0.24) 0 1px, rgba(0, 64, 70, 0) 1px 10px),
        linear-gradient(180deg, #0a5a61 0%, #004046 100%);
      clip-path: polygon(0 0, 4% 12%, 7% 0, 10% 15%, 13% 2%, 16% 18%, 19% 4%, 22% 16%, 25% 2%, 28% 18%, 31% 4%, 34% 16%, 37% 2%, 40% 18%, 43% 4%, 46% 16%, 49% 2%, 52% 17%, 55% 3%, 58% 16%, 61% 2%, 64% 17%, 67% 3%, 70% 16%, 73% 2%, 76% 17%, 79% 3%, 82% 16%, 85% 2%, 88% 17%, 91% 4%, 94% 16%, 97% 2%, 100% 14%, 100% 100%, 0 100%);
      pointer-events: none;
      z-index: 2;
    }

    .footer3_top-wrapper {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
      column-gap: 3rem;
    }

    .footer3_left-wrapper {
      min-width: 0 !important;
      width: 100%;
      max-width: none;
      padding: 2rem 2.75rem !important;
      box-sizing: border-box;
      margin-inline: 0;
      position: relative;
      overflow: hidden;
      clip-path: polygon(2% 0, 97% 0, 100% 4%, 99% 10%, 100% 16%, 98% 22%, 100% 28%, 98% 36%, 100% 44%, 98% 52%, 100% 60%, 99% 68%, 100% 76%, 98% 84%, 100% 92%, 97% 100%, 3% 100%, 0 96%, 1% 90%, 0 84%, 2% 78%, 0 72%, 2% 66%, 0 58%, 2% 50%, 0 42%, 2% 34%, 0 26%, 2% 18%, 0 10%, 2% 4%);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
    }

    .footer-project__logo,
    .footer-project__media,
    .footer-project__content {
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .footer-project__logo {
      display: flex;
      justify-content: center;
    }

    .logo-footer {
      width: 240px !important;
      margin: 0 auto !important;
      display: block;
      filter: brightness(0) invert(1);
    }

    .footer-media {
      width: 100% !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .footer-media__video {
      width: 100% !important;
      height: auto !important;
      object-fit: contain !important;
    }

    .footer3_details-wrapper {
      min-width: 0 !important;
    }

    .text-ime-galerije,
    .naslov-radno-vrijeme,
    .text-dodatni-info,
    .text-tel-radno {
      padding-left: 0 !important;
      color: #fff !important;
    }

    .footer-line--tagline {
      color: #fff !important;
    }

    .footer-line--description {
      color: #004046 !important;
    }

    .footer-line--project {
      color: #fff !important;
    }

    .footer-line--copyright {
      color: #004046 !important;
    }

    .footer-nav {
      display: grid;
      grid-template-columns: 1fr;
      align-content: start;
      row-gap: 1.75rem;
      min-width: 0;
    }

    .footer-nav__primary {
      display: block;
      justify-self: start;
    }

    .footer-nav__secondary {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2rem;
      row-gap: 1.25rem;
      margin-top: 2.25rem;
      align-items: start;
    }

    .footer-nav__column {
      min-width: 0;
      width: 100%;
    }

    .footer-nav__impressum {
      margin-top: 0.75rem;
      display: block;
      justify-self: start;
      text-align: left;
    }

    .footer1_link.link-impressum {
      margin-top: 0 !important;
      display: inline-block;
    }

    .navbar07_component,
    .navbar07_container,
    .navbar07_menu,
    .logos-container {
      align-items: center !important;
    }

    .body.is-vremeplov-page .navbar07_component {
      box-shadow: none !important;
      padding-bottom: 0 !important;
    }

    .body.is-vremeplov-page .navbar07_component::after {
      bottom: -16px;
    }

    .navbar07_menu {
      height: auto !important;
    }

    .navbar07_logo-link .uui-styleguide_logomark {
      height: auto !important;
      border: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      overflow: visible !important;
      background: transparent !important;
      display: flex !important;
      align-items: center !important;
    }

    .navbar07_logo-link .header-logo-image {
      display: block !important;
      width: auto !important;
      height: auto !important;
      max-width: none !important;
      max-height: none !important;
      border-radius: 0 !important;
      object-fit: contain !important;
      transform: scale(0.7) !important;
      transform-origin: left center !important;
    }

    @media (min-width: 992px) {
      .navbar07_menu-dropdown-main .navbar07_dropdown-list.w--open {
        background: #333230f7;
        border: 1px solid #4a4946;
        border-radius: 0.75rem;
        box-shadow: 0 12px 16px -4px #00000014, 0 4px 6px -2px #10182808;
        width: auto;
        min-width: 20rem;
        padding: 0.5rem;
        left: 50%;
        right: auto;
        transform: translateX(-50%);
      }

      .navbar07_menu-dropdown-main .navbar07_dropdown-link-list {
        display: grid;
        gap: 0.125rem;
      }

      .navbar07_menu-dropdown-main .navbar07_dropdown-link-2 {
        display: block;
        background-color: transparent;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
      }

      .navbar07_menu-dropdown-main .navbar07_dropdown-link-2:hover {
        background-color: #52514b;
        color: inherit;
      }

      .navbar07_menu-dropdown-main .navbar07_dropdown-link-2 .margin-bottom.margin-tiny {
        margin-bottom: 0;
      }

      .navbar07_menu-dropdown-lang .navbar07_dropdown-list.w--open {
        left: auto;
        right: 0;
        transform: none;
      }
    }

    @media (max-width: 991px) {
      .footer3_top-wrapper {
        grid-template-columns: 1fr !important;
        row-gap: 2rem;
      }

      .footer3_left-wrapper {
        padding: 1.5rem 0 !important;
        clip-path: polygon(2% 0, 97% 0, 100% 4%, 99% 11%, 100% 18%, 98% 26%, 100% 36%, 98% 46%, 100% 56%, 98% 66%, 100% 76%, 98% 86%, 100% 94%, 97% 100%, 3% 100%, 0 96%, 1% 88%, 0 80%, 2% 72%, 0 64%, 2% 56%, 0 48%, 2% 40%, 0 32%, 2% 24%, 0 16%, 2% 8%);
      }

      #w-node-footer-nav {
        grid-column: 1 / -1 !important;
        grid-row: auto !important;
      }

      .footer-nav {
        width: 100%;
        padding: 0 0 0.5rem;
        box-sizing: border-box;
      }

      .footer-project__content {
        margin-bottom: 1rem !important;
      }

      .footer-nav__secondary {
        grid-template-columns: 1fr;
        gap: 1.5rem;
        margin-top: 1.5rem;
      }
    }

    @media (max-width: 991px) {
      .navbar07_container {
        justify-content: space-between !important;
        align-items: center !important;
      }

      .navbar07_menu-button {
        order: 1;
        margin: 0 !important;
      }

      .logos-container {
        order: 2;
        margin-left: auto !important;
        margin-right: 0 !important;
        justify-content: flex-end !important;
        width: auto !important;
      }

      .navbar07_logo-link.mobile-size-logo.hide-on-desktop {
        display: block !important;
        position: static !important;
        inset: auto !important;
        left: auto !important;
        right: auto !important;
        z-index: 1 !important;
        margin-left: auto !important;
        margin-right: 0 !important;
        padding-right: 0 !important;
      }

      .navbar07_menu .navbar07_link,
      .navbar07_menu .navbar07_link:visited,
      .navbar07_menu .navbar07_link.w--current {
        color: var(--yellow-background) !important;
      }

      .footer3_left-wrapper {
        max-width: none;
        padding: 1.5rem 1.5rem 2rem !important;
      }

      .footer-nav {
        padding: 0 1.5rem 1rem;
      }

      .footer-nav__primary {
        margin-top: 0;
      }

      .footer-nav__secondary {
        grid-template-columns: 1fr;
        gap: 1.25rem;
        margin-top: 1rem;
      }

      .footer-nav__impressum {
        justify-content: flex-start;
      }
    }

  </style>
  <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
  <link href="/assets/images/final/favicon.png" rel="shortcut icon" type="image/x-icon" />
  <link href="/assets/images/final/app-icon.png" rel="apple-touch-icon" />
</head>
<body class="body">
  <div class="page-wrapper">
    <div class="main-wrapper">{%- include "partials/header.njk" -%}{{ content | safe }}{%- include "partials/footer.njk" -%}</div>
  </div>
  <script src="/assets/js/jquery.js?site=64ca73a36e15b3d43b1ede7e" type="text/javascript"></script>
  <script src="/assets/js/webflow-script.js" type="text/javascript"></script>
  <script src="/assets/js/main.js?v=20260306b" type="text/javascript"></script>
</body>
</html>

